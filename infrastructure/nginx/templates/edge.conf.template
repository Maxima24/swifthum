# Rendered to /etc/nginx/conf.d/edge.conf by the official nginx image on boot —
# ${DOMAIN} is substituted via envsubst. Nginx's own variables ($host, $remote_addr,
# etc.) use the bare $name form (no braces) so they are left untouched by envsubst.

# Mini App — served at https://${DOMAIN}/
server {
    listen 80;
    listen [::]:80;
    server_name swifthum.${DOMAIN};

    # Re-resolve upstreams via Docker's embedded DNS (127.0.0.11) so a recreated
    # container (new IP after `up --build`) is picked up without restarting the
    # edge. Without this nginx caches the IP at boot → 502 after every redeploy.
    resolver 127.0.0.11 valid=10s ipv6=off;

    include /etc/nginx/snippets/cloudflare-real-ip.conf;

    location / {
        set $miniapp_upstream miniapp;
        proxy_pass http://$miniapp_upstream:80$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# API — served at https://api.${DOMAIN}/
server {
    listen 80;
    listen [::]:80;
    server_name swifthum-api.${DOMAIN};

    # See note above — dynamic upstream resolution survives container recreation.
    resolver 127.0.0.11 valid=10s ipv6=off;

    include /etc/nginx/snippets/cloudflare-real-ip.conf;

    location / {
        set $api_upstream api;
        proxy_pass http://$api_upstream:3000$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

# Catch-all on the bare IP / unknown Host — close the connection. Prevents
# host-header probing tools from getting useful info.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
