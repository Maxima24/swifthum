# SwiftHum production .env — single file consumed by every service via
# `env_file:` in infrastructure/docker-compose.prod.yml.
# Copy to `infrastructure/prod/.env` and fill in. Never commit `.env`.
#
# Generate secrets:   openssl rand -hex 32

# ─── Public domain ───────────────────────────────────────────────────────
# Without subdomain. The Mini App is served at https://${DOMAIN}; the API at
# https://api.${DOMAIN}. Both DNS records must exist in Cloudflare with the
# proxy (orange cloud) enabled.
DOMAIN=quickbiteltd.org

# ─── Postgres (internal service) ─────────────────────────────────────────
POSTGRES_DB=swifthum
POSTGRES_USER=swifthum
POSTGRES_PASSWORD=                # openssl rand -hex 24
# The api/worker/bot all read DATABASE_URL; internal hostname is `postgres`.
DATABASE_URL=postgres://swifthum:${POSTGRES_PASSWORD}@postgres:5432/swifthum

# ─── Redis (internal service) ────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Telegram ────────────────────────────────────────────────────────────
# @swifthum_bot token from @BotFather. Used by both API (initData HMAC) and bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SEC=3600

# ─── Mini App / CORS ─────────────────────────────────────────────────────
# MINIAPP_URL  = the public origin the Mini App is served at (Telegram loads this).
# VITE_API_URL = the public API origin the Mini App calls (baked into the bundle at
#                build time — MUST match how the edge serves the API). With the
#                stock edge.conf.template that's https://swifthum-api.${DOMAIN}.
# CORS_ORIGIN  = must equal MINIAPP_URL so the browser can call the API cross-origin.
# IMPORTANT: these three hostnames must agree with the edge server_names and your
# Cloudflare DNS records, or API calls 404/CORS-fail. (See note in prod/README.md.)
MINIAPP_URL=https://swifthum.${DOMAIN}
VITE_API_URL=https://swifthum-api.${DOMAIN}
CORS_ORIGIN=https://swifthum.${DOMAIN}

# ─── API <→ Bot shared secret ────────────────────────────────────────────
# openssl rand -hex 32
INTERNAL_API_SECRET=

# ─── Auth ────────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─── Anthropic ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Groq (bot voice-note speech-to-text) ────────────────────────────────
# Optional. Free key at https://console.groq.com. Empty = voice notes disabled
# (the bot asks the user to type instead). Only the `bot` service reads these.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# ─── Prices (the Watcher's market data) ──────────────────────────────────
# Feed order: CoinGecko (NGN) → CoinMarketCap (NGN) → static. Keys optional but
# recommended in prod (keyless CoinGecko gets rate-limited from a server IP).
# Read by the `api` and `worker` services.
#   COINGECKO_API_KEY  free DEMO key — https://www.coingecko.com/en/developers/dashboard
#   CMC_API_KEY        free Basic key — https://coinmarketcap.com/api  (fallback source)
COINGECKO_API_KEY=
CMC_API_KEY=
# Price cache TTL (seconds). Higher = fewer upstream calls → free quotas last longer.
PRICES_CACHE_TTL_SEC=60

# ─── SwiftyEx ────────────────────────────────────────────────────────────
SWIFTYEX_MODE=sandbox
SWIFTYEX_BASE_URL=
SWIFTYEX_API_KEY=
# openssl rand -hex 32 — encrypts per-user SwiftyEx credentials at rest.
SWIFTYEX_KEY_ENC_SECRET=

# ─── Payments ────────────────────────────────────────────────────────────
# Token validity window. 30s is fine for an instant ultrasonic chirp, but a QR
# scan (open camera, grant permission, aim, decode) often takes longer — use 120
# so QR payments don't expire mid-scan.
PAYMENT_INTENT_TTL_SEC=120
# openssl rand -hex 32 — HMAC key for the swfh.<b64body>.<b64sig> payment token.
PAYMENT_TOKEN_SECRET=
# openssl rand -hex 32 — HMAC key for URL-signed tokens (verifiable receipts).
# Distinct from PAYMENT_TOKEN_SECRET; used by common/signed-token.ts.
SIGNED_TOKEN_SECRET=

# ─── Gifts ───────────────────────────────────────────────────────────────
# Bot @username (no @) — used to build gift deep-links: t.me/<BOT_USERNAME>?start=gift_<code>
BOT_USERNAME=swifthum_bot
# How long an unclaimed gift lives before the worker auto-refunds it (hours).
GIFT_TTL_HOURS=168

# ─── Worker ──────────────────────────────────────────────────────────────
WATCHER_TICK_INTERVAL_SEC=20
# Weekly insights digest schedule (cron). Default: Sundays 09:00 server time.
# Set to '* * * * *' temporarily to smoke-test the digest DM.
WEEKLY_DIGEST_CRON=0 9 * * 0

# ─── Wallet seed (one-time on user signup) ───────────────────────────────
WALLET_SEED_NGN_MINOR=2500000

# ─── Bot → API ───────────────────────────────────────────────────────────
# Internal Docker network hostname.
API_BASE_URL=http://api:3000

# ─── Server / logging ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
