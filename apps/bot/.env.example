# Telegram bot token from @BotFather (must match apps/api/.env's TELEGRAM_BOT_TOKEN)
TELEGRAM_BOT_TOKEN=

# Redis (same instance as the API uses for swifthum.notifications)
REDIS_URL=redis://localhost:6379

# Mini App launch URL. **Must be HTTPS** for Telegram WebApp buttons.
# For local dev: `cloudflared tunnel --url http://localhost:5173` and use the
# resulting *.trycloudflare.com URL. Also add that URL to apps/api/.env's CORS_ORIGIN.
MINIAPP_URL=https://your-tunnel.trycloudflare.com

# Where the bot calls the API. Use the container/service name in compose.
API_BASE_URL=http://localhost:3000

# Shared secret with apps/api/.env's INTERNAL_API_SECRET
INTERNAL_API_SECRET=

# Logging
LOG_LEVEL=INFO
