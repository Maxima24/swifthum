// SwiftHum API — Prisma schema. Money is BIGINT minor units (kobo).
// IDs are app-generated with cuid2 + prefix (e.g. u_xxx, r_xxx, i_xxx, tx_xxx).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id
  telegramId           BigInt           @unique
  username             String?          @unique // lowercased Telegram @handle — for pay-by-username
  email                String?          // optional — where the user wants emailed receipts
  displayName          String
  notificationsEnabled Boolean          @default(true)
  acquiredVia          String?          // funnel tag for users onboarded via a feature (e.g. 'gift')
  createdAt            DateTime         @default(now())

  wallet         Wallet?
  rules          Rule[]
  intents        PaymentIntent[]
  transactions   Transaction[]
  swiftyAccount  SwiftyexAccount?
  swiftyHoldings SwiftyexHolding[]
  swiftyOrders   SwiftyexOrder[]
  giftsSent      Gift[]            @relation("GiftsSent")
  giftsClaimed   Gift[]            @relation("GiftsClaimed")
  escrowsCreated Escrow[]          @relation("EscrowsCreated")
  escrowsJoined  Escrow[]          @relation("EscrowsJoined")
}

model SwiftyexAccount {
  id          String   @id
  userId      String   @unique
  apiKey      String   // AES-256-GCM ciphertext (see credential-crypto.ts), never plaintext
  label       String?
  linkedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SwiftyexHolding {
  id        String   @id
  userId    String
  asset     String
  qtyBase   BigInt   @default(0) // asset base units at 8 decimals (QTY_SCALE)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset])
}

model SwiftyexOrder {
  id               String   @id
  userId           String
  side             String   // buy | sell
  asset            String
  amountMinor      BigInt
  status           String   // success | failed | simulated | pending
  filledPriceMinor BigInt?
  filledQtyBase    BigInt?
  detail           String?
  externalId       String?  // the live SwiftyEx order id, once wired
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Wallet {
  userId       String @id
  balanceMinor BigInt @default(0)
  currency     String @default("NGN")

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Rule {
  id              String    @id
  userId          String
  name            String
  whenAsset       String
  whenOp          String
  whenPriceMinor  BigInt
  thenAction      String
  thenAmountMinor BigInt?
  thenCurrency    String?
  state           String    @default("sleeping")
  firedCount      Int       @default(0)
  lastEvaluatedAt DateTime?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions      RuleExecution[]

  @@index([userId, createdAt])
  @@index([state])
}

model RuleExecution {
  id               String   @id
  ruleId           String
  firedAt          DateTime @default(now())
  priceAtFireMinor BigInt
  outcome          String
  detail           String?

  rule             Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, firedAt])
}

model PriceSnapshot {
  id         String   @id
  asset      String
  priceMinor BigInt
  takenAt    DateTime @default(now())

  @@index([asset, takenAt])
}

model PaymentIntent {
  id          String    @id
  senderId    String
  amountMinor BigInt
  currency    String    @default("NGN")
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  refundedAt  DateTime?
  riskScore   Float     @default(0.1)
  createdAt   DateTime  @default(now())

  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([expiresAt, consumedAt, refundedAt])
}

model Transaction {
  id               String   @id
  userId           String
  direction        String   // sent | received
  amountMinor      BigInt
  currency         String   @default("NGN")
  counterpartyName String
  intentId         String?
  settledAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, settledAt])
}

model UsedNonce {
  tokenHash String   @id
  usedAt    DateTime @default(now())
}

// ─── Double-entry ledger (accounting system-of-record) ───────────────────────
// Wallet remains the user-facing balance source-of-truth; its `wallet`
// LedgerAccount is kept in lockstep by LedgerService. System accounts (treasury,
// payment_hold, …) are singletons by kind (enforced by a partial unique index in
// the migration, since Prisma can't express `WHERE ownerUserId IS NULL`).

model LedgerAccount {
  id           String   @id
  kind         String   // wallet | treasury | payment_hold | escrow_hold | gift_unclaimed
  ownerUserId  String?  @unique // set for kind=wallet; null for system singletons
  currency     String   @default("NGN")
  balanceMinor BigInt   @default(0) // cached: == Σ(credits) − Σ(debits) of its entries
  createdAt    DateTime @default(now())

  entries      LedgerEntry[]

  @@index([kind])
}

model LedgerTransaction {
  id             String   @id
  kind           String   // seed | reserve | redeem | refund | gift_create | gift_claim | escrow_fund | escrow_release | …
  idempotencyKey String?  @unique
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  entries        LedgerEntry[]

  @@index([createdAt])
}

model LedgerEntry {
  id          String   @id
  txId        String
  accountId   String
  direction   String   // debit | credit  (per tx: Σ debits == Σ credits)
  amountMinor BigInt
  createdAt   DateTime @default(now())

  tx          LedgerTransaction @relation(fields: [txId], references: [id], onDelete: Cascade)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([txId])
}

// ─── Gift Links (§1) ─────────────────────────────────────────────────────────
// A sender locks funds into a shareable claim link. Money sits in the
// `gift_unclaimed` LedgerAccount until claimed/refunded. FSM enforced in the
// service layer: UNCLAIMED → CLAIMED | EXPIRED | RECLAIMED.

model Gift {
  id              String    @id
  senderId        String
  asset           String    @default("NGN")
  amountMinor     BigInt
  message         String?
  claimCode       String    @unique // the capability — high-entropy, single-use
  state           String    @default("UNCLAIMED")
  claimedByUserId String?
  ttlExpiresAt    DateTime
  stateUpdatedAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  claimedAt       DateTime?

  sender          User      @relation("GiftsSent", fields: [senderId], references: [id], onDelete: Cascade)
  claimedBy       User?     @relation("GiftsClaimed", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([senderId, createdAt])
  @@index([state, ttlExpiresAt]) // drives the worker expiry sweep
}

// ─── Verifiable Receipts (§2) ────────────────────────────────────────────────
// Emitted on every completed money movement. `token` is a signed (HMAC) URL
// token (common/signed-token.ts) that anyone can re-verify server-side. Names
// are masked snapshots — no internal ids leak into the shareable artifact. No
// User FK so a receipt stands alone as permanent proof.

model Receipt {
  id          String   @id
  sourceType  String   // payment | gift | escrow
  sourceId    String
  fromUserId  String
  toUserId    String
  fromName    String   // masked display-name snapshot at emit time
  toName      String
  asset       String   @default("NGN")
  amountMinor BigInt
  token       String   // signed shareable token (embeds nonce/iat/exp)
  emailedAt   DateTime? // set once the receipt has been emailed (auto on success, or manual)
  createdAt   DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
}

// ─── P2P Escrow (§3) ─────────────────────────────────────────────────────────
// Money sits in the `escrow_hold` LedgerAccount from funding until resolution.
// creator = buyer/funder; counterparty = seller/receiver (bound on join via a
// shareable link). FSM enforced in the service layer (common/fsm.ts).

model Escrow {
  id             String    @id
  creatorId      String    // buyer / funder
  counterpartyId String?   // seller / receiver — bound on join
  asset          String    @default("NGN")
  amountMinor    BigInt
  terms          String?
  joinCode       String    @unique
  state          String    @default("PROPOSED")
  ttlExpiresAt   DateTime
  stateUpdatedAt DateTime  @default(now())
  createdAt      DateTime  @default(now())

  creator        User      @relation("EscrowsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  counterparty   User?     @relation("EscrowsJoined", fields: [counterpartyId], references: [id], onDelete: SetNull)
  events         EscrowEvent[]

  @@index([creatorId, createdAt])
  @@index([counterpartyId, createdAt])
  @@index([state, ttlExpiresAt]) // drives the worker expiry sweep
}

// Append-only audit trail of every escrow transition (mirrors RuleExecution).
model EscrowEvent {
  id         String   @id
  escrowId   String
  type       String   // proposed|joined|accepted|declined|cancelled|paid_marked|released|disputed|resolved_released|resolved_refunded|expired
  actorId    String?  // null = system/worker
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  escrow     Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId, createdAt])
}
