# Postgres
DATABASE_URL=postgres://swifthum:swifthum@localhost:5432/swifthum

# Redis
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SEC=3600

# Auth
JWT_SECRET=change-me-to-32-random-bytes-or-more
JWT_EXPIRES_IN=24h

# Bot → API channel (must match apps/bot/.env)
INTERNAL_API_SECRET=change-me-to-32-random-bytes-or-more

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Prices — the Watcher's market data. Feed order: CoinGecko (NGN) → CoinMarketCap
# (NGN) → static.
#   COINGECKO_API_KEY  optional free DEMO key (coingecko.com/en/developers/dashboard);
#                      empty = keyless public endpoint.
#   CMC_API_KEY        free Basic key (coinmarketcap.com/api) for the fallback;
#                      empty = fallback disabled (CoinGecko-only, then static).
COINGECKO_API_KEY=
CMC_API_KEY=
# Price cache TTL (seconds). Higher = fewer upstream calls, longer-lived free quota.
PRICES_CACHE_TTL_SEC=60

# SwiftyEx
SWIFTYEX_MODE=sandbox                       # sandbox | live  (legacy alias: simulated = sandbox)
SWIFTYEX_BASE_URL=                          # read by the live client only
SWIFTYEX_API_KEY=                           # app-level key, read by the live client only
SWIFTYEX_KEY_ENC_SECRET=change-me-to-32-random-bytes-or-more  # AES-256-GCM key for per-user credentials at rest

# Payment intent — 30s suits ultrasonic; bump to 120 so QR scans don't expire mid-scan
PAYMENT_INTENT_TTL_SEC=120
PAYMENT_TOKEN_SECRET=change-me-to-32-random-bytes-or-more

# Worker
WATCHER_TICK_INTERVAL_SEC=20
# Weekly insights digest cron (default Sundays 09:00). Use '* * * * *' to smoke-test.
WEEKLY_DIGEST_CRON=0 9 * * 0

# Wallet
WALLET_SEED_NGN_MINOR=2500000

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173,https://eastern-adding-replacing-flying.trycloudflare.com
NODE_ENV=development
LOG_LEVEL=info
